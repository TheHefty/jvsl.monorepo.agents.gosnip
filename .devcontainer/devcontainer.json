{
  "name": "jvsl.monorepo.agents.gosnip",
  "image": "jvsl.monorepo.agents.gosnip-dev",
  "workspaceMount": "source=/home/jvlima/Projetos/jvsl.monorepo.agents.gosnip,target=/config/workspace,type=bind",
  "workspaceFolder": "/config/workspace",
  "mounts": [
    "source=jvsl.monorepo.agents.gosnip-code-server-data,target=/config,type=volume",
    "source=/home/jvlima/.claude,target=/config/.claude,type=bind",
    "target=/config/.claude/rules,type=tmpfs"
  ],
  "capAdd": [
    "SYS_ADMIN"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "systempaths=unconfined"
  ],
  "containerEnv": {
    "PUID": "1000",
    "PGID": "1000"
  },
  "overrideCommand": false,
  "runArgs": [
    "--memory",
    "6g",
    "--memory-swap",
    "6g",
    "--cpuset-cpus",
    "0-7",
    "--device",
    "/dev/fuse",
    "--device",
    "/dev/net/tun",
    "--device",
    "/dev/kvm"
  ],
  "x-jvsl-generated": {
    "extension": "0.3.0"
  }
}
