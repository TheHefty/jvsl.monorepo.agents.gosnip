#!/usr/bin/env bash
# Cheap repository-wide checks, run before a commit is written.
#
# Enable it per clone:
#     git config core.hooksPath .githooks
#
# It cannot be enabled for you by a commit — git config is not versioned, which
# is deliberate on git's part: a repository you clone should not be able to run
# code on your machine by shipping a hook. Same arrangement as the template's
# own .githooks/pre-push.
#
# The check itself lives in the template and arrives by bump, so this repository
# stops carrying a second copy of it. A second copy is the thing that drifts,
# and it drifts silently: the rule is written in one place and enforced from
# another, and nothing says which of the two is current.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# check-md-size ships in the agent container's image, on its PATH (FR-127).
# In a window connected to the project's container the editor's git runs
# inside it, where the image's PATH is. Say why, rather than dying on a
# missing command.
if ! command -v check-md-size >/dev/null 2>&1; then
    echo "pre-commit: check-md-size is not on PATH. It ships in the agent container's image:" >&2
    echo "pre-commit: commit from a window connected to the project's container, or rebuild its image." >&2
    exit 1
fi

exec check-md-size --root "$HERE/.."
